name: fan
description: nested plan fixture
steps:
    - id: setup
      run: "true"
    - id: fan
      parallel:
        wait: all
        branches:
            - id: b1
              run: /usr/local/bin/charly -C /proj/.opencharly/pipelines/fan task _pipeline-fan-b1 --output
            - id: b2
              run: echo $setup.exit_code
