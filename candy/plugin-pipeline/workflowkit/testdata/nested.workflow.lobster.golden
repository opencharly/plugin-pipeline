name: nested
description: ordering chain fixture
steps:
    - id: zulu
      on_error: stop
      run: /usr/local/bin/charly -C /proj/.opencharly/pipelines/nested task _pipeline-nested-zulu --output
    - id: middle
      on_error: stop
      run: /usr/local/bin/charly -C /proj/.opencharly/pipelines/nested task _pipeline-nested-middle --output
    - id: alpha
      on_error: stop
      run: /usr/local/bin/charly -C /proj/.opencharly/pipelines/nested task _pipeline-nested-alpha --output
