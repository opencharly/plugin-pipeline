name: e2e
description: end-to-end lowering fixture
args:
    who:
        description: who to greet
        default: world
steps:
    - id: fetch
      on_error: stop
      run: /usr/local/bin/charly -C /proj/.opencharly/pipelines/e2e task _pipeline-e2e-fetch --output
    - id: probe
      on_error: stop
      env:
        REF_1: $fetch.json.name
        REF_2: $fetch.json.n
      run: /usr/local/bin/charly -C /proj/.opencharly/pipelines/e2e task _pipeline-e2e-probe --output -p REF_1="$REF_1" -p REF_2="$REF_2"
    - id: bed
      on_error: stop
      run: /usr/local/bin/charly -C /proj/.opencharly/pipelines/e2e task _pipeline-e2e-bed --output
    - id: verify
      on_error: stop
      pipeline: verify
    - id: confirm
      on_error: stop
      approval: Proceed with ${who}?
    - id: final
      on_error: stop
      run: /usr/local/bin/charly -C /proj/.opencharly/pipelines/e2e task _pipeline-e2e-final --output
