# GENERATED by charly's workflow lowering — do not edit; edit the pipeline and re-lower.
# The engine runs this file as the ROOT (charly -C <this dir> …), so the import: below is
# resolved RELATIVE TO THIS FILE'S OWN DIRECTORY.
# It MUST flat-import the project's charly.yml BY FILE PATH: the loader reads a flat
# (non-@) import entry straight with os.ReadFile and never joins it against a directory,
# so pointing it at a DIRECTORY (e.g. `../../..`) silently fails to load. Only an
# @-namespaced entry is stat'ed and joined with the unified file name — so a file path is
# the ONE form that works for a flat import.
import:
    - ../../../charly.yml
_pipeline-redo-oracle:
    task:
        description: lowered from pipeline step redo/oracle
        plan:
            - run: rewind the oracle
              task:
                redo:
                    escalate_after: 5
                    max: 4
                    triggers:
                        redo-plan: oracle
                task: oracle
_pipeline-redo-renode:
    task:
        description: lowered from pipeline step redo/renode
        plan:
            - task:
                redo:
                    max: 2
                    triggers:
                        redo-plan: renode
                task: renode
_pipeline-redo-plain:
    task:
        description: lowered from pipeline step redo/plain
        plan:
            - task:
                task: plain
