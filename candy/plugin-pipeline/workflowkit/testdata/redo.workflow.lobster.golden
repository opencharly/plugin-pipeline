name: redo
description: redo-carry fixture
steps:
    - id: oracle
      redo:
        escalate_after: 5
        max: 4
        triggers:
            redo-plan: oracle
      run: /usr/local/bin/charly -C /proj/.opencharly/pipelines/redo task _pipeline-redo-oracle --output
    - id: renode
      redo:
        max: 2
        triggers:
            redo-plan: renode
      run: /usr/local/bin/charly -C /proj/.opencharly/pipelines/redo task _pipeline-redo-renode --output
    - id: plain
      run: /usr/local/bin/charly -C /proj/.opencharly/pipelines/redo task _pipeline-redo-plain --output
